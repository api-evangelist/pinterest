        {
          "id": "d636ad89-950b-4480-b07c-b7b6f61eb44e",
          "name": "List report stats",
          "request": {
            "name": "List report stats",
            "description": {
              "content": "List aggregated numbers of issues for a catalog owned by the \"operation user_account\".\n- By default, the \"operation user_account\" is the token user_account.\n\nOptional: Business Access: Specify an <code>ad_account_id</code> (obtained via <a href='/docs/api/v5/#operation/ad_accounts/list'>List ad accounts</a>) to use the owner of that ad_account as the \"operation user_account\". In order to do this, the token user_account must have one of the following <a href=\"https://help.pinterest.com/en/business/article/share-and-manage-access-to-your-ad-accounts\">Business Access</a> roles on the ad_account: Owner, Admin, Catalogs Manager.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "catalogs",
                "reports",
                "stats"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ad_account_id",
                  "value": "<string>",
                  "description": "Unique identifier of an ad account."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "25",
                  "description": "Maximum number of items to include in a single page of the response. See documentation on <a href='/docs/getting-started/pagination/'>Pagination</a> for more information."
                },
                {
                  "disabled": false,
                  "key": "bookmark",
                  "value": "<string>",
                  "description": "Cursor used to fetch the next page of items"
                },
                {
                  "disabled": false,
                  "key": "parameters[catalog_type]",
                  "value": "<string>",
                  "description": "(Required) Contains the parameters for report identification."
                },
                {
                  "disabled": false,
                  "key": "parameters[report][report_type]",
                  "value": "<string>",
                  "description": "(Required) Contains the parameters for report identification."
                },
                {
                  "disabled": false,
                  "key": "parameters[report][feed_id]",
                  "value": "<string>",
                  "description": "(Required) Contains the parameters for report identification."
                },
                {
                  "disabled": false,
                  "key": "parameters[report][processing_result_id]",
                  "value": "<string>",
                  "description": "(Required) Contains the parameters for report identification."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "ads:read ads:write billing:read billing:write biz_access:read biz_access:write boards:read boards:read_secret boards:write boards:write_secret catalogs:read catalogs:write pins:read pins:read_secret pins:write pins:write_secret user_accounts:read user_accounts:write"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.pinterest.com/v5/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://www.pinterest.com/oauth/"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
