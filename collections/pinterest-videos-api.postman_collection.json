        {
          "id": "f720ac44-9d4d-407a-a33c-564c4edd0574",
          "name": "Get user account top video pins analytics",
          "request": {
            "name": "Get user account top video pins analytics",
            "description": {
              "content": "Gets analytics data about a user's top video pins (limited to the top 50).\n- By default, the \"operation user_account\" is the token user_account.\n\nOptional: Business Access: Specify an ad_account_id to use the owner of that ad_account as the \"operation user_account\".",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "user_account",
                "analytics",
                "top_video_pins"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "(Required) Metric report start date (UTC). Format: YYYY-MM-DD. Cannot be more than 90 days back from today."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "(Required) Metric report end date (UTC). Format: YYYY-MM-DD. Cannot be more than 90 days past start_date."
                },
                {
                  "disabled": false,
                  "key": "sort_by",
                  "value": "<string>",
                  "description": "(Required) Specify sorting order for video metrics"
                },
                {
                  "disabled": false,
                  "key": "from_claimed_content",
                  "value": "BOTH",
                  "description": "Filter on Pins that match your claimed domain."
                },
                {
                  "disabled": false,
                  "key": "pin_format",
                  "value": "ALL",
                  "description": "Pin formats to get data for, default is all."
                },
                {
                  "disabled": false,
                  "key": "app_types",
                  "value": "ALL",
                  "description": "Apps or devices to get data for, default is all."
                },
                {
                  "disabled": false,
                  "key": "content_type",
                  "value": "ALL",
                  "description": "Filter to paid or organic data. Default is all."
                },
                {
                  "disabled": false,
                  "key": "source",
                  "value": "ALL",
                  "description": "Filter to activity from Pins created and saved by your, or activity created and saved by others from your claimed accounts"
                },
                {
                  "disabled": false,
                  "key": "metric_types",
                  "value": "<string>,<string>",
                  "description": "Metric types to get video data for, default is all. "
                },
                {
                  "disabled": false,
                  "key": "num_of_pins",
                  "value": "10",
                  "description": "Number of pins to include, default is 10. Max is 50."
                },
                {
                  "disabled": false,
                  "key": "created_in_last_n_days",
                  "value": "<integer>",
                  "description": "Get metrics for pins created in the last \"n\" days."
                },
                {
                  "disabled": false,
                  "key": "ad_account_id",
                  "value": "<string>",
                  "description": "Unique identifier of an ad account."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "ads:read ads:write billing:read billing:write biz_access:read biz_access:write boards:read boards:read_secret boards:write boards:write_secret catalogs:read catalogs:write pins:read pins:read_secret pins:write pins:write_secret user_accounts:read user_accounts:write"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.pinterest.com/v5/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://www.pinterest.com/oauth/"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
