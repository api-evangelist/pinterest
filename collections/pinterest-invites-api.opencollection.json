          "docs": "Accept or decline invites or requests."
        },
        {
          "info": {
            "name": "Update invite/request with an asset permission",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pinterest.com/v5/businesses/:business_id/invites/assets/access",
            "params": [
              {
                "name": "business_id",
                "value": "729090764583391194",
