      "item": [
        {
          "id": "ea1f7c7c-6f26-4ab4-8505-9d59437b2903",
          "name": "Create async request for an analytics report using a template",
          "request": {
            "name": "Create async request for an analytics report using a template",
            "description": {
              "content": "This takes a template ID and an optional custom timeframe and constructs an asynchronous report based on the\ntemplate. It returns a token that you can use to download the report when it is ready.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ad_accounts",
                ":ad_account_id",
                "templates",
                ":template_id",
                "reports"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "Metric report start date (UTC). Format: YYYY-MM-DD. Cannot be more than 2.5 years back from today."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "Metric report end date (UTC). Format: YYYY-MM-DD. Cannot be more than 2.5 years past start date."
                },
                {
                  "disabled": false,
                  "key": "granularity",
                  "value": "<string>",
                  "description": "TOTAL - metrics are aggregated over the specified date range.<br> DAY - metrics are broken down daily.<br> HOUR - metrics are broken down hourly.<br>WEEKLY - metrics are broken down weekly.<br>MONTHLY - metrics are broken down monthly"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ad_account_id",
                  "description": "(Required) Unique identifier of an ad account."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "template_id",
                  "description": "(Required) Unique identifier of a template."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "ads:read ads:write billing:read billing:write biz_access:read biz_access:write boards:read boards:read_secret boards:write boards:write_secret catalogs:read catalogs:write pins:read pins:read_secret pins:write pins:write_secret user_accounts:read user_accounts:write"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.pinterest.com/v5/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://www.pinterest.com/oauth/"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
          "response": [
            {
              "id": "4e2cf7cd-1eb9-4ccc-8df0-f35d2656b2b8",
