        {
          "id": "86317b9f-9020-418e-b2b8-94ceb42bb8ab",
          "name": "Get country's keyword metrics",
          "request": {
            "name": "Get country's keyword metrics",
            "description": {
              "content": "See keyword metrics for a specified country, aggregated across all of Pinterest.\n(Definitions are available from the \"Get delivery metrics definitions\"\n<a href=\"/docs/api/v5/#operation/delivery_metrics/get\">API endpoint</a>).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ad_accounts",
                ":ad_account_id",
                "keywords",
                "metrics"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "country_code",
                  "value": "<string>",
                  "description": "(Required) Two letter country code (ISO 3166-1 alpha-2)"
                },
                {
                  "disabled": false,
                  "key": "keywords",
                  "value": "<string>",
                  "description": "(Required) Comma-separated keywords"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ad_account_id",
                  "description": "(Required) Unique identifier of an ad account."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "ads:read ads:write billing:read billing:write biz_access:read biz_access:write boards:read boards:read_secret boards:write boards:write_secret catalogs:read catalogs:write pins:read pins:read_secret pins:write pins:write_secret user_accounts:read user_accounts:write"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.pinterest.com/v5/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://www.pinterest.com/oauth/"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
          "response": [
            {
