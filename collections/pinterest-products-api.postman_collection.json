        {
          "id": "6904a24d-2747-442e-94a7-3c8dad5f38e6",
          "name": "List products for a Product Group",
          "request": {
            "name": "List products for a Product Group",
            "description": {
              "content": "Get a list of product pins for a given Catalogs Product Group Id owned by the \"operation user_account\".\n- By default, the \"operation user_account\" is the token user_account.\n\nOptional: Business Access: Specify an <code>ad_account_id</code> (obtained via <a href='/docs/api/v5/#operation/ad_accounts/list'>List ad accounts</a>) to use the owner of that ad_account as the \"operation user_account\". In order to do this, the token user_account must have one of the following <a href=\"https://help.pinterest.com/en/business/article/share-and-manage-access-to-your-ad-accounts\">Business Access</a> roles on the ad_account: Owner, Admin, Catalogs Manager.\n\nNote: This endpoint only supports RETAIL catalog at the moment.\n\n<a href='/docs/shopping/catalog/'>Learn more</a>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "catalogs",
                "product_groups",
                ":product_group_id",
                "products"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "bookmark",
                  "value": "<string>",
                  "description": "Cursor used to fetch the next page of items"
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "25",
                  "description": "Maximum number of items to include in a single page of the response. See documentation on <a href='/docs/getting-started/pagination/'>Pagination</a> for more information."
                },
                {
                  "disabled": false,
                  "key": "ad_account_id",
                  "value": "<string>",
                  "description": "Unique identifier of an ad account."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "product_group_id",
                  "description": "(Required) Unique identifier of a product group"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
