          "request": {
            "name": "Get audience insights",
            "description": {
              "content": "Get Audience Insights for an ad account. The response will return insights for 3 types of audiences: the\nad account's engaged audience on Pinterest, the ad account's total audience on Pinterest and Pinterest's\ntotal audience.<p/>\n<a href=\"https://help.pinterest.com/en/business/article/audience-insights\" target=\"_blank\">Learn more about Audience Insights</a>.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ad_accounts",
                ":ad_account_id",
                "audience_insights"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "audience_insight_type",
                  "value": "YOUR_TOTAL_AUDIENCE",
                  "description": "(Required) Type of audience insights."
                }
