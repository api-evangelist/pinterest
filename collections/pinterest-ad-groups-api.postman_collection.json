              "raw": "{\n  \"auto_targeting_enabled\": true,\n  \"placement_group\": \"ALL\",\n  \"creative_types\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"targeting_spec\": {\n    \"AGE_BUCKET\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"APPTYPE\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"AUDIENCE_EXCLUDE\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"AUDIENCE_INCLUDE\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"GENDER\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"GEO\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"INTEREST\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"LOCALE\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"LOCATION\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"SHOPPING_RETARGETING\": [\n      {\n        \"lookback_window\": \"<integer>\",\n        \"tag_types\": [\n          \"<integer>\",\n          \"<integer>\"\n        ],\n        \"exclusion_window\": \"<integer>\"\n      },\n      {\n        \"lookback_window\": \"<integer>\",\n        \"tag_types\": [\n          \"<integer>\",\n          \"<integer>\"\n        ],\n        \"exclusion_window\": \"<integer>\"\n      }\n    ],\n    \"TARGETING_STRATEGY\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  },\n  \"product_group_ids\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"keywords\": [\n    {\n      \"match_type\": \"<string>\",\n      \"value\": \"<string>\"\n    },\n    {\n      \"match_type\": \"<string>\",\n      \"value\": \"<string>\"\n    }\n  ]\n}",
