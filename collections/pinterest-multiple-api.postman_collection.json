        {
          "id": "744d2e8b-c87d-4c18-8749-b0b1b2330b30",
          "name": "Create multiple product group",
          "request": {
            "name": "Create multiple product group",
            "description": {
              "content": "Create product group to use in Catalogs owned by the \"operation user_account\".\n- By default, the \"operation user_account\" is the token user_account.\n\nOptional: Business Access: Specify an <code>ad_account_id</code> (obtained via <a href='/docs/api/v5/#operation/ad_accounts/list'>List ad accounts</a>) to use the owner of that ad_account as the \"operation user_account\". In order to do this, the token user_account must have one of the following <a href=\"https://help.pinterest.com/en/business/article/share-and-manage-access-to-your-ad-accounts\">Business Access</a> roles on the ad_account: Owner, Admin, Catalogs Manager.\n\n<a href='/docs/shopping/catalog/'>Learn more</a>\n\nNote: The catalog type of Creative Assets is only allowed in the <a href='https://api-sandbox.pinterest.com/v5'>Pinterest API Sandbox</a>.\nIf access is required, please contact your partner manager.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "catalogs",
                "product_groups",
                "multiple"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ad_account_id",
                  "value": "<string>",
                  "description": "Unique identifier of an ad account."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "ads:read ads:write billing:read billing:write biz_access:read biz_access:write boards:read boards:read_secret boards:write boards:write_secret catalogs:read catalogs:write pins:read pins:read_secret pins:write pins:write_secret user_accounts:read user_accounts:write"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.pinterest.com/v5/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://www.pinterest.com/oauth/"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"name\": \"<string>\",\n    \"filters\": {\n      \"any_of\": [\n        {\n          \"value\": \"<Error: Too many levels of nesting to fake this schema>\"\n        }\n      ]\n    },\n    \"feed_id\": \"<string>\",\n    \"description\": \"<string>\",\n    \"is_featured\": false\n  },\n  {\n    \"name\": \"<string>\",\n    \"filters\": {\n      \"any_of\": [\n        {\n          \"value\": \"<Error: Too many levels of nesting to fake this schema>\"\n        }\n      ]\n    },\n    \"feed_id\": \"<string>\",\n    \"description\": \"<string>\",\n    \"is_featured\": false\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "ee87d8d6-5356-4c9f-88da-3d1cf4a19dfe",
              "name": "Success",
              "originalRequest": {
                "url": {
                  "path": [
                    "catalogs",
                    "product_groups",
                    "multiple"
                  ],
                  "host": [
