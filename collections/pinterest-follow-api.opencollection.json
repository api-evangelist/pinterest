{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pinterest Follow API",
    "version": "5.13.0"
  },
  "items": [
    {
      "info": {
        "name": "Follow",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List following interests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pinterest.com/v5/users/:username/interests/follow",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path",
                "description": "A valid username"
              },
              {
                "name": "bookmark",
                "value": "",
                "type": "query",
                "description": "Cursor used to fetch the next page of items"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to include in a single page of the response. See documentation on <a href='/docs/getting-started/pagination/'>Pagination</a> for more information."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://www.pinterest.com/oauth/",
              "accessTokenUrl": "https://api.pinterest.com/v5/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get a list of a user's following interests in one place."
        }
      ]
    }
  ],
  "bundled": true
}